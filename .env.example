# Copy to .env. Deposit addresses are derived from public account extended keys.
# Never place seed phrases or private keys in this file or send them in chat.
# Sepolia confirmed events can appear in a separate testnet ledger; mainnet stays disabled.
# On Vercel, configure DATABASE_URL to a persistent PostgreSQL connection string.
DATABASE_URL=
BTC_ACCOUNT_XPUB=
EVM_ACCOUNT_XPUB=
TRON_ACCOUNT_XPUB=

# Optional Turnkey EVM address provider. Keep the API private key only in
# Vercel's encrypted environment variables or another server-side secret store.
# The Ethereum address must match the wallet's m/44'/60'/0'/0/0 account.
# Turnkey addresses are chain-agnostic; this does not restrict them to Sepolia.
# Production address issuance remains blocked until mainnet monitoring/accounting are verified.
DEPOSIT_EVM_PROVIDER=xpub
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ID=
TURNKEY_EXPECTED_ETH_ADDRESS=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Testnet-only monitor. Configure a QuickNode Streams webhook with its Security
# token set to QUICKNODE_STREAMS_SECRET. The stream payload must be JSON:
# {"chainId":"0xaa36a7","logs":[...Transfer logs...],"transactions":[...]}
# using the fields consumed by deposit-monitor.js. RPC must point to Sepolia.
QUICKNODE_STREAMS_SECRET=
SEPOLIA_RPC_URL=
SEPOLIA_CONFIRMATIONS=
SEPOLIA_USDC_CONTRACT=
SEPOLIA_USDT_CONTRACT=
# Set true only after the Sepolia webhook and RPC configuration have been tested.
SEPOLIA_DEPOSITS_ENABLED=false

# Optional legacy Shieldz invoice API; direct-address deposits do not use this.
SHIELDZ_API_KEY=

# Legacy Solana address-generator settings (not used for BTC/ETH/USDC/USDT deposits).
# The signer must implement:
# POST {SOLANA_SIGNER_URL}/derive-address
# Authorization: Bearer <SOLANA_SIGNER_TOKEN>
# JSON request: {"index": 0, "asset": "SOL"|"USDT", "network": "solana"}
# JSON response: {"address": "<base58 address>"}
# For USDT, return a valid, initialized SPL-token deposit account for the configured USDT mint.
# The signer must never return secret key material.
SOLANA_SIGNER_URL=
SOLANA_SIGNER_TOKEN=

# Sweep preparation only: the prototype does not monitor chains or send transactions.
# These values do not enable sweeping. Configure a separate monitor and signer only
# after implementing and auditing their chain-specific API contracts.
CHAIN_MONITOR_URL=
CHAIN_MONITOR_TOKEN=
SWEEP_SIGNER_URL=
SWEEP_SIGNER_TOKEN=

# Sweep preparation only: these are public destination addresses, not deposit addresses.
SWEEP_DESTINATION_BTC_BITCOIN=
SWEEP_DESTINATION_ETH_ETHEREUM=
SWEEP_DESTINATION_USDT_ETHEREUM=
SWEEP_DESTINATION_USDT_TRON=
SWEEP_DESTINATION_USDT_SOLANA=
SWEEP_DESTINATION_USDT_BSC=
SWEEP_DESTINATION_SOL_SOLANA=
SWEEP_DESTINATION_BNB_BSC=

# Confirmation thresholds must be deliberately set for the selected providers/networks.
SWEEP_CONFIRMATIONS_BITCOIN=
SWEEP_CONFIRMATIONS_ETHEREUM=
SWEEP_CONFIRMATIONS_TRON=
SWEEP_CONFIRMATIONS_SOLANA=
SWEEP_CONFIRMATIONS_BSC=

# Local development binds to loopback. Vercel supplies the public HTTPS endpoint.
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
